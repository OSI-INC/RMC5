IOBUF PORT "mcu_addr[2]" IO_TYPE=LVCMOS33 PULLMODE=DOWN ;
IOBUF PORT "mcu_addr[3]" IO_TYPE=LVCMOS33 PULLMODE=DOWN ;
IOBUF PORT "mcu_addr[4]" IO_TYPE=LVCMOS33 PULLMODE=DOWN ;
IOBUF PORT "mcu_addr[5]" IO_TYPE=LVCMOS33 PULLMODE=DOWN ;
IOBUF PORT "mcu_addr[6]" IO_TYPE=LVCMOS33 PULLMODE=DOWN ;
IOBUF PORT "mcu_data[0]" IO_TYPE=LVCMOS33 PULLMODE=DOWN ;
IOBUF PORT "mcu_data[1]" IO_TYPE=LVCMOS33 PULLMODE=DOWN ;
IOBUF PORT "mcu_data[2]" IO_TYPE=LVCMOS33 PULLMODE=DOWN ;
IOBUF PORT "mcu_data[3]" IO_TYPE=LVCMOS33 PULLMODE=DOWN ;
IOBUF PORT "mcu_data[4]" IO_TYPE=LVCMOS33 PULLMODE=DOWN ;
